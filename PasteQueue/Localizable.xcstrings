        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coincide com Copiar/Colar/Recortar do próprio macOS — também será acionado em qualquer uso comum em outro lugar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Совпадает со стандартными Копировать/Вставить/Вырезать в macOS — будет срабатывать при любом обычном использовании этих команд."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "与 macOS 自带的复制/粘贴/剪切快捷键相同 — 在其他任何普通使用场景中也会触发。"
