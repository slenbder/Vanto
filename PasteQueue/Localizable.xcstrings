    "Matches macOS's own Copy/Paste/Cut — will also fire on every ordinary use elsewhere." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entspricht dem systemeigenen Kopieren/Einfügen/Ausschneiden von macOS — wird auch bei jeder gewöhnlichen Nutzung anderswo ausgelöst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Matches macOS's own Copy/Paste/Cut — will also fire on every ordinary use elsewhere."
