        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coincide con Copiar/Pegar/Cortar del propio macOS — también se activará en cualquier uso normal en otro lugar."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS 標準のコピー/ペースト/カットと同じです — 他の通常の操作でも実行されます。"
