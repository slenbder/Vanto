    "License deactivation is not configured in this build." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Lizenzdeaktivierung ist in diesem Build nicht konfiguriert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "License deactivation is not configured in this build."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La desactivación de licencias no está configurada en esta compilación."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このビルドではライセンスの無効化が設定されていません。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A desativação de licença não está configurada nesta compilação."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В этой сборке не настроена деактивация лицензии."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此版本未配置许可证停用。"
          }
        }
      }
    },
    "Vanto will stop working on this Mac when the trial has ended. This frees one of your three device slots." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vanto funktioniert auf diesem Mac nach Ablauf des Testzeitraums nicht mehr. Dadurch wird einer Ihrer drei Geräteplätze frei."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vanto will stop working on this Mac when the trial has ended. This frees one of your three device slots."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vanto dejará de funcionar en este Mac cuando termine la prueba. Esto libera uno de tus tres dispositivos."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "トライアル終了後、このMacではVantoを使用できなくなります。3台分のデバイス枠のうち1台分が空きます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Vanto deixará de funcionar neste Mac quando o período de teste terminar. Isso libera uma das suas três vagas de dispositivo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "После окончания пробного периода Vanto перестанет работать на этом Mac. Освободится один из трёх слотов устройств."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "试用期结束后，Vanto 将无法在这台 Mac 上使用。这会释放三个设备名额中的一个。"
          }
        }
      }
    },
    "The device slot was released, but the local license could not be removed. Try again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Geräteplatz wurde freigegeben, aber die lokale Lizenz konnte nicht entfernt werden. Versuchen Sie es erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The device slot was released, but the local license could not be removed. Try again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se liberó el dispositivo, pero no se pudo eliminar la licencia local. Inténtalo de nuevo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "デバイス枠は解放されましたが、ローカルライセンスを削除できませんでした。もう一度お試しください。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A vaga do dispositivo foi liberada, mas não foi possível remover a licença local. Tente novamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Слот устройства освобождён, но локальную лицензию удалить не удалось. Повторите попытку."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "设备名额已释放，但无法移除本地许可证。请重试。"
          }
        }
      }
    },
