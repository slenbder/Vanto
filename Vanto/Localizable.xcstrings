    "Connect to the internet to deactivate this Mac." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stellen Sie eine Internetverbindung her, um diesen Mac zu deaktivieren."
